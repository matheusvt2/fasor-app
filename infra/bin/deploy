#!/usr/bin/env bash
# Deploys the committed HEAD to the production stack (Story 11.8): builds the api, ocr and
# caddy images for the instance's platform, pushes them to ECR tagged with the commit SHA,
# runs the migrations as a one-shot ECS task, rolls the services and waits for
# GET /api/health over HTTPS to report every component up, records the tag, then runs the
# production smoke (Story 14.10 part 6): the smoke-seed task resets the test company, the
# Playwright suite under e2e/production/ runs against the deployed URL in the tools
# container, the usage events of the run are counted in CloudWatch (a warning, never a
# failure), and the smoke-seed task runs again as the cleanup, always. A red smoke exits 1
# naming the failing step and the rollback command; nothing rolls back by itself. The AWS CLI
# calls that are safe to repeat are retried when the endpoint drops (aws_retry, lib.sh), and
# an exit after the roll and before the smoke finished prints the --resume command
# (E15-A10). Everything runs in containers (infra/bin/tf, infra/bin/aws, docker buildx, or
# podman build where there is no docker); the AWS login session of AWS_PROFILE (default
# fasor-admin) must be active for a real run.
#
#   infra/bin/deploy [--dry-run] [--skip-build] [--skip-smoke] [--resume] [--tag <sha>]
#
#   --dry-run     print every step's command, prefixed DRY-RUN:, with placeholder outputs;
#                 touches nothing (no build, no push, no AWS or Terraform call)
#   --skip-build  deploy images already in ECR under the tag (no build, no push)
#   --skip-smoke  deploy without the production smoke (its four steps say so)
#   --resume      finish a deploy whose roll already ran: skips build, push, migrate and roll,
#                 checks (read-only) that every service runs the tag, then waits for the
#                 services, health, record and smoke
#   --tag <sha>   the tag to deploy; default the HEAD commit. Building needs it to be HEAD.
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
bin="$root/infra/bin"
# shellcheck source=lib.sh
. "$bin/lib.sh"
stack=production

dry_run=0
skip_build=0
skip_smoke=0
resume=0
tag=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=1 ;;
    --skip-build) skip_build=1 ;;
    --skip-smoke) skip_smoke=1 ;;
    # A resumed deploy never builds: its images were pushed by the run it resumes.
    --resume) resume=1; skip_build=1 ;;
    --tag)
      [ $# -ge 2 ] || { echo "deploy: --tag needs a value" >&2; exit 2; }
      tag="$2"; shift ;;
    -h|--help) sed -n '2,26p' "$0"; exit 0 ;;
    *) echo "deploy: unknown argument '$1'" >&2; exit 2 ;;
  esac
  shift
done

step_number=0
step() {
  step_number=$((step_number + 1))
  printf '\n==> %d. %s\n' "$step_number" "$*"
}

# run <command...>: runs it, or prints it in a dry run.
run() {
  if [ "$dry_run" = 1 ]; then
    printf 'DRY-RUN:'; printf ' %q' "$@"; printf '\n'
  else
    "$@"
  fi
}

# capture <placeholder> <command...>: prints the command's output, or the placeholder in
# a dry run (after printing the command).
capture() {
  local placeholder="$1"; shift
  if [ "$dry_run" = 1 ]; then
    printf 'DRY-RUN:' >&2; printf ' %q' "$@" >&2; printf '  -> %s\n' "$placeholder" >&2
    printf '%s' "$placeholder"
  else
    "$@"
  fi
}

tf=("$bin/tf" "$stack")
aws=("$bin/aws")
output() { capture "$2" "${tf[@]}" output -raw "$1"; }

fail() {
  echo "deploy: $*" >&2
  exit 1
}

# E15-A10: once the roll has started, any exit before the smoke finished (a lost endpoint the
# retries did not outlast, a red health, an unforeseen error) names the command that finishes
# the deploy without building, migrating or rolling again.
rolled=0
finished=0
on_exit() {
  local status=$?
  if [ "$status" != 0 ] && [ "$rolled" = 1 ] && [ "$finished" = 0 ]; then
    local hint="infra/bin/deploy --resume --tag $tag"
    [ "$skip_smoke" = 1 ] && hint="$hint --skip-smoke"
    printf '\ndeploy: the roll to %s started, but the deploy stopped before it finished\n' "$tag" >&2
    echo "deploy: to resume: $hint" >&2
    echo "deploy: (--resume refuses when a service does not run $tag; then rerun the deploy without it)" >&2
  fi
}
trap on_exit EXIT

# --- preflight -----------------------------------------------------------------------
step "preflight: clean tree, tag, tools"
# The usage-events check of the smoke counts what landed since this instant (epoch ms).
read -r deploy_start_s deploy_start_iso < <(date -u '+%s %Y-%m-%dT%H:%M:%SZ')
deploy_start_ms=$((deploy_start_s * 1000))
head_sha="$(git -C "$root" rev-parse HEAD)"
dirty="$(git -C "$root" status --porcelain)"
if [ -n "$dirty" ]; then
  if [ "$dry_run" = 1 ]; then
    echo "the working tree has uncommitted changes: a real run would refuse here"
  else
    fail "the working tree has uncommitted changes; commit or stash them first (only committed code is deployed)"
  fi
fi
[ -n "$tag" ] || tag="$head_sha"
if [ "$skip_build" = 0 ] && [ "$tag" != "$head_sha" ]; then
  fail "--tag $tag is not HEAD ($head_sha); building tags HEAD only (use --skip-build to deploy an already pushed tag)"
fi
command -v "$CTR" >/dev/null || fail "docker or podman is required"
command -v curl >/dev/null || fail "curl is required"
echo "tag: $tag"
[ "$resume" = 1 ] && echo "resuming the deploy of $tag: build, push, migrate and roll are skipped"
run "${tf[@]}" init -input=false

# --- read the stack ------------------------------------------------------------------
step "read the Terraform outputs"
platform="$(output platform linux/amd64)"
registry="$(output ecr_registry 673409896745.dkr.ecr.us-east-1.amazonaws.com)"
ecr_api="$(output ecr_api_url "$registry/fasor/api")"
ecr_ocr="$(output ecr_ocr_url "$registry/fasor/ocr")"
ecr_caddy="$(output ecr_caddy_url "$registry/fasor/caddy")"
cluster="$(output cluster_name fasor-production)"
services="$(output service_names 'api caddy ocr')"
migrate_family="$(output migrate_task_family fasor-production-migrate)"
migrate_log_group="$(output migrate_log_group /fasor/production/migrate)"
image_tag_parameter="$(output image_tag_parameter /fasor/production/image-tag)"
smoke_family="$(output smoke_task_family fasor-production-smoke-seed)"
smoke_log_group="$(output smoke_log_group /fasor/production/smoke)"
smoke_secret_id="$(output smoke_secret_id fasor-production/smoke-user-password)"
smoke_email="$(output smoke_user_email smoke-producao@teste.local)"
public_url="$(output public_url https://203.0.113.10)"
# With app_domain set, Caddy holds a certificate for that name only, so a verified request to
# the bare address fails TLS: the health check goes to app_url when there is one (2026-10-14).
app_url="$(output app_url '')"
health_url="${app_url:-$public_url}"
echo "platform $platform, cluster $cluster, services: $services, url $health_url"
read -r -a service_list <<<"$services"

# --- build and push ------------------------------------------------------------------
# The ECR tags are immutable (storage.tf): a tag already pushed is deployed as it is, never
# rebuilt and pushed again (the push would be refused). A dry run never asks ECR.
image_in_ecr() {
  [ "$dry_run" = 1 ] && return 1
  "${aws[@]}" ecr describe-images --repository-name "$1" --image-ids "imageTag=$tag" >/dev/null 2>&1
}
images_in_ecr() {
  local repository
  for repository in fasor/api fasor/ocr fasor/caddy; do
    image_in_ecr "$repository" || return 1
  done
}
# image_build <image> <context> [build args...]: docker builds with buildx and loads the
# image into the local store; podman has no buildx, and its `build` already stores it.
image_build() {
  local image="$1" context="$2"; shift 2
  if [ "$CTR" = podman ]; then
    run podman build --platform "$platform" "$@" -t "$image" "$context"
  else
    run "$CTR" buildx build --platform "$platform" "$@" -t "$image" --load "$context"
  fi
}
# Pushes one image unless its tag is already in ECR (an earlier run that failed half way).
push_missing() {
  local repository="$1" image="$2"
  if image_in_ecr "$repository"; then
    echo "$repository:$tag is already in ECR (immutable tags): not pushed again"
  else
    run "$CTR" push "$image"
  fi
}
if [ "$skip_build" = 0 ] && images_in_ecr; then
  echo "tag $tag is already in ECR (immutable tags): deploying it without a rebuild"
  skip_build=1
fi
if [ "$resume" = 1 ]; then
  for name in "build the images for $platform" "push the images to ECR"; do
    step "$name"
    echo "skipped by --resume"
  done
elif [ "$skip_build" = 0 ]; then
  step "build the images for $platform"
  # Epic 18: the web bundle's usage events carry this tag as their `app_version`.
  image_build "$ecr_api:$tag" "$root" -f "$root/apps/api/Dockerfile.prod" --build-arg "VITE_APP_VERSION=$tag"
  image_build "$ecr_ocr:$tag" "$root/services/ocr" --target runtime
  image_build "$ecr_caddy:$tag" "$root/infra/caddy"

  step "push the images to ECR"
  if [ "$dry_run" = 1 ]; then
    printf 'DRY-RUN: %q ecr get-login-password | %s login --username AWS --password-stdin %q\n' "$bin/aws" "$CTR" "$registry"
  else
    "${aws[@]}" ecr get-login-password | "$CTR" login --username AWS --password-stdin "$registry"
  fi
  push_missing fasor/api "$ecr_api:$tag"
  push_missing fasor/ocr "$ecr_ocr:$tag"
  push_missing fasor/caddy "$ecr_caddy:$tag"
else
  step "check the images are in ECR (--skip-build)"
  for repository in fasor/api fasor/ocr fasor/caddy; do
    run "${aws[@]}" ecr describe-images --repository-name "$repository" --image-ids "imageTag=$tag" --query 'imageDetails[0].imageTags' --output text
  done
fi

# --- migrate -------------------------------------------------------------------------
# run_one_shot <label> <family> <log group> <stream prefix> <dry-run exit code> [<consequence>]:
# runs one task of the family on the instance (EC2 launch type) and waits for it to stop. Sets
# one_shot_task (the task id) and one_shot_exit (the container's exit code); returns 1, after
# printing why and where its log is, when it did not start, did not stop in 30 minutes or
# exited non-zero (the consequence, if any, ends that last message).
# The dry-run exit code stands in for the container's (DEPLOY_DRY_RUN_*_EXIT), so the gates
# after it can be exercised without AWS (scripts/deploy.test.ts).
run_one_shot() {
  local label="$1" family="$2" log_group="$3" stream_prefix="$4" dry_exit="$5" consequence="${6:-}" task_arn last_status attempt count
  one_shot_task=""
  one_shot_exit=""
  # After a night stop or on the first deploy the instance may still be joining the cluster.
  if [ "$dry_run" = 1 ]; then
    printf 'DRY-RUN: wait until %q ecs list-container-instances --cluster %q lists one instance\n' "$bin/aws" "$cluster"
  else
    for attempt in $(seq 1 60); do
      # A stopped instance stays ACTIVE with its agent disconnected; only a connected agent counts.
      count="$(aws_retry "${aws[@]}" ecs list-container-instances --cluster "$cluster" --status ACTIVE --filter 'agentConnected==true' --query 'length(containerInstanceArns)' --output text)" \
        || { echo "deploy: aws ecs list-container-instances failed (is the AWS session still valid?)" >&2; return 1; }
      [ "$count" -ge 1 ] && break
      if [ "$attempt" = 60 ]; then
        echo "deploy: no container instance joined $cluster in 10 minutes (is the instance stopped?)" >&2
        return 1
      fi
      sleep 10
    done
  fi
  task_arn="$(capture "arn:aws:ecs:us-east-1:673409896745:task/$cluster/0123456789abcdef0123456789abcdef" \
    "${aws[@]}" ecs run-task --cluster "$cluster" --launch-type EC2 --task-definition "$family" \
    --started-by "deploy-${tag:0:12}" --query 'tasks[0].taskArn' --output text)" || task_arn=""
  if [ -z "$task_arn" ] || [ "$task_arn" = "None" ]; then
    echo "deploy: the $label task did not start (aws ecs run-task returned no task; see its failures)" >&2
    return 1
  fi
  one_shot_task="${task_arn##*/}"
  # Own wait instead of `ecs wait tasks-stopped` (which gives up after about 10 minutes while
  # the task keeps running, so a rerun would start a second one): up to 30 minutes.
  if [ "$dry_run" = 1 ]; then
    printf 'DRY-RUN: wait until %q ecs describe-tasks --cluster %q --tasks %q reports STOPPED\n' "$bin/aws" "$cluster" "$task_arn"
  else
    for attempt in $(seq 1 180); do
      last_status="$(aws_retry "${aws[@]}" ecs describe-tasks --cluster "$cluster" --tasks "$task_arn" --query 'tasks[0].lastStatus' --output text)" \
        || { echo "deploy: aws ecs describe-tasks failed (is the AWS session still valid?)" >&2; return 1; }
      [ "$last_status" = "STOPPED" ] && break
      if [ "$attempt" = 180 ]; then
        echo "deploy: the $label task $one_shot_task is still $last_status after 30 minutes; do not rerun the deploy until it stops (its log: group $log_group)" >&2
        return 1
      fi
      sleep 10
    done
  fi
  one_shot_exit="$(capture "$dry_exit" aws_retry "${aws[@]}" ecs describe-tasks --cluster "$cluster" --tasks "$task_arn" \
    --query 'tasks[0].containers[0].exitCode' --output text)" || one_shot_exit="unknown"
  if [ "$one_shot_exit" != "0" ]; then
    echo "deploy: the $label task exited with '$one_shot_exit'$consequence" >&2
    echo "deploy: its log: group $log_group, stream $stream_prefix/$one_shot_task" >&2
    return 1
  fi
}

step "migrate: one-shot ECS task on the new api image"
if [ "$resume" = 1 ]; then
  # The tag was migrated by the run being resumed: a rerun would start a second migrate task.
  echo "skipped by --resume"
else
  run "${tf[@]}" apply -input=false -auto-approve -var "image_tag=$tag" -target=aws_ecs_task_definition.migrate
  # DEPLOY_DRY_RUN_MIGRATION_EXIT: the placeholder exit code of a dry run (default 0). A failed
  # migration stops the deploy before any roll.
  run_one_shot migration "$migrate_family" "$migrate_log_group" migrate/migrate "${DEPLOY_DRY_RUN_MIGRATION_EXIT:-0}" \
    "; the services were not rolled" || exit 1
  echo "migrations applied (task $one_shot_task)"
fi

# --- roll ----------------------------------------------------------------------------
step "roll the services to $tag"
if [ "$resume" = 1 ]; then
  echo "skipped by --resume"
  # Read-only: a resume records only a tag every service already runs, never one that did not roll.
  step "check the services run $tag (--resume)"
  for service in "${service_list[@]}"; do
    task_definition="$(capture "arn:aws:ecs:us-east-1:673409896745:task-definition/$cluster-$service:1" \
      aws_retry "${aws[@]}" ecs describe-services --cluster "$cluster" --services "$service" \
      --query 'services[0].taskDefinition' --output text)" \
      || fail "could not read the service $service (aws ecs describe-services failed)"
    # DEPLOY_DRY_RUN_RESUME_IMAGE_TAG: the placeholder tag of the images a dry run reads (default: the tag).
    images="$(capture "$registry/fasor/$service:${DEPLOY_DRY_RUN_RESUME_IMAGE_TAG:-$tag}" \
      aws_retry "${aws[@]}" ecs describe-task-definition --task-definition "$task_definition" \
      --query 'taskDefinition.containerDefinitions[].image' --output text)" \
      || fail "could not read the task definition $task_definition of the service $service"
    for image in $images; do
      [ "${image##*:}" = "$tag" ] || fail "the service $service runs $image (task definition $task_definition), not the tag $tag; nothing was recorded (run the deploy without --resume)"
    done
    echo "$service runs $images"
  done
else
  rolled=1
  run "${tf[@]}" apply -input=false -auto-approve -var "image_tag=$tag"
fi
# A resume reaches here once every service runs the tag: from now on its exit hints a resume too.
rolled=1

step "wait until the services are stable"
run aws_retry "${aws[@]}" ecs wait services-stable --cluster "$cluster" --services "${service_list[@]}"
# DEPLOY_DRY_RUN_STABLE_EXIT: a dry run's stand-in for a wait that failed (default 0), for the resume hint.
if [ "$dry_run" = 1 ] && [ "${DEPLOY_DRY_RUN_STABLE_EXIT:-0}" != 0 ]; then
  echo 'aws: [ERROR]: Could not connect to the endpoint URL: "https://ecs.us-east-1.amazonaws.com/" (dry-run placeholder)' >&2
  exit "$DEPLOY_DRY_RUN_STABLE_EXIT"
fi

# --- health --------------------------------------------------------------------------
step "health: GET $health_url/api/health until every component is up"
if [ "$dry_run" = 1 ]; then
  printf 'DRY-RUN: curl -fsS %q  -> {"status":"up","db":"up","queue":"up","storage":"up","libreoffice":"up"}\n' "$health_url/api/health"
else
  # The first deploy waits for Caddy's first certificate, so give it a few minutes.
  for attempt in $(seq 1 60); do
    # No -f: a 503 "degraded" body names the component that is down.
    body="$(curl -sS --max-time 10 "$health_url/api/health" 2>/dev/null || true)"
    if [[ "$body" == *'"status":"up"'* ]]; then
      echo "$body"
      break
    fi
    [ "$attempt" = 60 ] && fail "health never reported every component up; last answer: ${body:-none}"
    sleep 5
  done
fi

# Only a healthy roll becomes the tag a later plain `terraform apply` keeps (ssm.tf). The tag
# it replaces is read first: the smoke's rollback hint names it.
step "record $tag as the deployed tag"
previous_tag="$(capture fedcba9876543210fedcba9876543210fedcba98 aws_retry "${aws[@]}" ssm get-parameter --name "$image_tag_parameter" \
  --query Parameter.Value --output text)" || previous_tag=""
run aws_retry "${aws[@]}" ssm put-parameter --name "$image_tag_parameter" --value "$tag" --overwrite

# --- smoke ---------------------------------------------------------------------------
# Story 14.10 part 6. The suite signs in as the smoke user (smoke.tf) and writes only into
# that company; the smoke-seed task resets it before and cleans it up after, always, also
# after a red suite. No automatic rollback (open question Q-1, 2026-10-15).
smoke_dir="$root/test-results/production-smoke"
smoke_reset="smoke: reset the test company"
smoke_suite="smoke: run the production suite"
smoke_telemetry="smoke: check the usage events"
smoke_cleanup="smoke: clean up the test company"
if [ "$skip_smoke" = 1 ]; then
  for name in "$smoke_reset" "$smoke_suite" "$smoke_telemetry" "$smoke_cleanup"; do
    step "$name"
    echo "skipped by --skip-smoke"
  done
  finished=1
  printf '\ndeployed %s to %s (smoke skipped by --skip-smoke)\n' "$tag" "$health_url"
  exit 0
fi

# E18-A2 (batch e18fb, 2026-11-03): the usage events still land. Read-only (CloudWatch Logs
# FilterLogEvents with the deploy's own login), counts only (never an event body, id or
# e-mail), and a warning, never a failure, in this release: the deferred-work row of batch
# e18fb makes it a failure after its first green production run. The group names are read
# here, after the roll, so the first deploy carrying their outputs has them.
# telemetry_count <placeholder> <log group> <filter pattern>: the number of events of the group
# since the deploy started that match the pattern, or a non-zero return when it cannot be read.
# JSON output: with `--output text` the CLI applies the query per page of the paginated call
# and prints one number per page.
telemetry_count() {
  local placeholder="$1" group="$2" pattern="$3" count
  count="$(capture "$placeholder" aws_retry "${aws[@]}" logs filter-log-events --log-group-name "$group" \
    --start-time "$deploy_start_ms" --filter-pattern "$pattern" --query 'length(events)' --output json)" || return 1
  [[ "$count" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$count"
}
check_usage_events() {
  local ux_group api_group sessions="" failures="" attempt warned=0
  local session_pattern="{ (\$.name = \"session_start\") && (\$.app_version = \"$tag\") }"
  ux_group="$(output ux_events_log_group /fasor/production/ux-events)" || ux_group=""
  api_group="$(output api_log_group /fasor/production/api)" || api_group=""
  if [ -z "$ux_group" ] || [ -z "$api_group" ]; then
    echo "deploy: warning: could not read the outputs ux_events_log_group and api_log_group; the usage events were not checked" >&2
    return 0
  fi
  # A CloudWatch line appears seconds after the put: poll up to about 2 minutes while the count
  # reads 0. A read error stops the poll (the retry already outlasted a lost endpoint); a dry
  # run asks once.
  for attempt in $(seq 1 12); do
    sessions="$(telemetry_count "${DEPLOY_DRY_RUN_TELEMETRY_SESSIONS:-1}" "$ux_group" "$session_pattern")" || { sessions=""; break; }
    if [ "$dry_run" = 1 ] || { [ -n "$sessions" ] && [ "$sessions" -ge 1 ]; }; then break; fi
    [ "$attempt" = 12 ] || sleep 10
  done
  failures="$(telemetry_count "${DEPLOY_DRY_RUN_TELEMETRY_SINK_FAILURES:-0}" "$api_group" '"ux_event_sink_failed"')" || failures=""
  echo "telemetry: ${sessions:-unknown} session_start with app_version $tag since $deploy_start_iso; ${failures:-unknown} ux_event_sink_failed"
  if [ -z "$sessions" ]; then
    echo "deploy: warning: could not read the session_start events of $ux_group" >&2; warned=1
  elif [ "$sessions" = 0 ]; then
    echo "deploy: warning: 0 session_start with app_version $tag in $ux_group since $deploy_start_iso: the usage events may not be landing (docs/observability.md)" >&2; warned=1
  fi
  if [ -z "$failures" ]; then
    echo "deploy: warning: could not read the ux_event_sink_failed lines of $api_group" >&2; warned=1
  elif [ "$failures" != 0 ]; then
    echo "deploy: warning: $failures ux_event_sink_failed in $api_group since $deploy_start_iso: the api could not write usage events" >&2; warned=1
  fi
  [ "$warned" = 1 ] && echo "deploy: (a warning only in this release; the deploy's exit is unchanged)" >&2
  return 0
}

smoke_failed=""
suite_ran=0
step "$smoke_reset"
if run_one_shot smoke-seed "$smoke_family" "$smoke_log_group" smoke/smoke-seed "${DEPLOY_DRY_RUN_SMOKE_SEED_EXIT:-0}"; then
  echo "test company reset (task $one_shot_task)"
else
  smoke_failed="$smoke_reset"
fi

step "$smoke_suite"
if [ -n "$smoke_failed" ]; then
  echo "not run: the reset failed"
else
  # A progress file of an earlier deploy must never be read as where this run stopped.
  [ "$dry_run" = 1 ] || rm -rf "$smoke_dir"
  # The password goes from Secrets Manager into this shell's environment and from there to the
  # container by name (-e SMOKE_PASSWORD): never on a command line, never printed.
  if ! SMOKE_PASSWORD="$(capture '<secret>' "${aws[@]}" secretsmanager get-secret-value --secret-id "$smoke_secret_id" \
    --query SecretString --output text)"; then
    echo "deploy: could not read the smoke user's password from Secrets Manager ($smoke_secret_id)" >&2
    smoke_failed="$smoke_suite"
  fi
fi
if [ -z "$smoke_failed" ]; then
  export SMOKE_PASSWORD
  export SMOKE_BASE_URL="$health_url" SMOKE_EMAIL="$smoke_email"
  # AGENTS.md: no Playwright run outside the host lock, when this host has one (up to 30 min).
  lock=()
  if command -v lockf >/dev/null 2>&1; then
    lock=(lockf -t 1800 /tmp/fasor-verify.lock)
  elif command -v flock >/dev/null 2>&1; then
    lock=(flock -w 1800 /tmp/fasor-verify.lock)
  else
    echo "neither lockf nor flock on this host: the suite runs without the host lock /tmp/fasor-verify.lock"
  fi
  # The operator's checkout already holds the tools image and its node_modules volumes from a
  # gate run (infra/PUBLISHING.md); --no-deps keeps the local stack down.
  suite=("$CTR" compose --profile tools run --rm --no-deps)
  [ "$CTR" = podman ] && suite+=(--user root)
  suite+=(-e SMOKE_BASE_URL -e SMOKE_EMAIL -e SMOKE_PASSWORD tools pnpm smoke:production)
  suite_exit=0
  suite_ran=1
  if [ "$dry_run" = 1 ]; then
    (cd "$root" && run ${lock[@]+"${lock[@]}"} "${suite[@]}")
    # DEPLOY_DRY_RUN_SMOKE_EXIT: the suite's placeholder exit code (default 0), for the red path.
    suite_exit="${DEPLOY_DRY_RUN_SMOKE_EXIT:-0}"
  else
    (cd "$root" && run ${lock[@]+"${lock[@]}"} "${suite[@]}") || suite_exit=$?
  fi
  unset SMOKE_PASSWORD
  if [ "$suite_exit" = 0 ]; then
    echo "production suite passed"
  else
    smoke_failed="$smoke_suite"
  fi
fi

step "$smoke_telemetry"
if [ "$suite_ran" = 1 ]; then
  check_usage_events || echo "deploy: warning: the usage-events check stopped early; the deploy's exit is unchanged" >&2
else
  echo "not run: the suite did not run"
fi

# The cleanup runs whatever happened above: the test company never keeps a run's writes.
cleanup_failed=0
step "$smoke_cleanup"
# DEPLOY_DRY_RUN_SMOKE_CLEANUP_EXIT: the cleanup's own placeholder exit code (default: the reset's).
if run_one_shot smoke-seed "$smoke_family" "$smoke_log_group" smoke/smoke-seed \
  "${DEPLOY_DRY_RUN_SMOKE_CLEANUP_EXIT:-${DEPLOY_DRY_RUN_SMOKE_SEED_EXIT:-0}}"; then
  echo "test company cleaned up (task $one_shot_task)"
else
  cleanup_failed=1
fi
# The smoke has run to its end: from here a red exit is a red smoke, reported below, not a
# deploy to resume.
finished=1

if [ -n "$smoke_failed" ] || [ "$cleanup_failed" = 1 ]; then
  printf '\n' >&2
  if [ -n "$smoke_failed" ]; then
    echo "deploy: smoke failed at step: $smoke_failed" >&2
    if [ "$smoke_failed" = "$smoke_suite" ]; then
      # Each step of the suite appends its name when it starts: the last one is where it stopped.
      if [ -s "$smoke_dir/progress.txt" ]; then
        echo "deploy: the suite stopped in: $(tail -n 1 "$smoke_dir/progress.txt")" >&2
      fi
      echo "deploy: report: $smoke_dir (report.json, progress.txt, screenshots under artifacts/)" >&2
    else
      echo "deploy: its log: group $smoke_log_group" >&2
    fi
  fi
  if [ "$cleanup_failed" = 1 ]; then
    echo "deploy: smoke failed at step: $smoke_cleanup; the test company still holds this run's writes (the next deploy's reset empties it)" >&2
  fi
  if [ -n "$smoke_failed" ]; then
    echo "deploy: $tag is deployed and recorded; nothing was rolled back" >&2
    if [ -n "$previous_tag" ] && [ "$previous_tag" != "none" ] && [ "$previous_tag" != "$tag" ]; then
      echo "deploy: to roll back: infra/bin/deploy --skip-build --skip-smoke --tag $previous_tag" >&2
      echo "deploy: (--skip-smoke because an image older than Story 14.10 part 6 has no smoke-seed task to run)" >&2
    else
      echo "deploy: no earlier tag was recorded to roll back to; fix forward" >&2
    fi
  fi
  exit 1
fi

printf '\ndeployed %s to %s; production smoke passed\n' "$tag" "$health_url"
