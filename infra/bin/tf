#!/usr/bin/env bash
# Runs Terraform in a container (AD-27: nothing on the host) against the AWS login
# session of one profile. Usage: infra/bin/tf <dir under infra/> <terraform args...>
# AWS_PROFILE picks the profile (default: fasor-admin). The session is read by the
# pinned aws-cli image as the calling user, so ~/.aws never gets root-owned files. The
# container CLI is docker, else podman (`lib.sh`).
# TF_OFFLINE=1 skips the session export, for the commands that never reach AWS
# (`init -backend=false`, `validate`, `fmt`, `providers lock`); infra/bin/check uses it.
# TF_DATA_DIR, when set, reaches the container as it is (relative to the stack directory);
# infra/bin/check uses it to keep its own data dir apart from the operator's `.terraform`.
set -euo pipefail
dir="$1"; shift
root="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib.sh
. "$root/bin/lib.sh"
profile="${AWS_PROFILE:-fasor-admin}"
creds=""
if [ "${TF_OFFLINE:-0}" != "1" ]; then
  creds="$(aws_session_env "$profile")"
fi
# A terminal only when both ends are one, so `$(infra/bin/tf ... output -raw x)` in the
# deploy script never gets carriage returns.
tty=(); [ -t 0 ] && [ -t 1 ] && tty=(-it)
data_dir=""
[ -n "${TF_DATA_DIR:-}" ] && data_dir="TF_DATA_DIR=$TF_DATA_DIR"
exec "$CTR" run --rm ${tty[@]+"${tty[@]}"} --user "$(id -u):$(id -g)" -e HOME=/tmp \
  --env-file <(printf '%s\nAWS_REGION=%s\n%s\n' "$creds" "$AWS_REGION_DEFAULT" "$data_dir") \
  -v "$root:/infra" -w "/infra/$dir" hashicorp/terraform:1.16.4 "$@"
