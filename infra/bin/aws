#!/usr/bin/env bash
# Runs the AWS CLI in a container (AD-27: nothing on the host) with the AWS login session
# of one profile, exported the same way infra/bin/tf does. Usage: infra/bin/aws <args...>
# AWS_PROFILE picks the profile (default: fasor-admin). Region us-east-1.
set -euo pipefail
profile="${AWS_PROFILE:-fasor-admin}"
image=amazon/aws-cli:2.37.6
creds="$(docker run --rm --user "$(id -u):$(id -g)" -e HOME=/home/aws \
  -v "$HOME/.aws:/home/aws/.aws" "$image" \
  configure export-credentials --profile "$profile" --format env-no-export)"
# stdin is passed through (-i) so a caller can pipe into it; a terminal only when both
# ends are one, so captured output never gets carriage returns.
tty=(-i); [ -t 0 ] && [ -t 1 ] && tty=(-it)
exec docker run --rm "${tty[@]}" --user "$(id -u):$(id -g)" -e HOME=/tmp \
  --env-file <(printf '%s\nAWS_REGION=us-east-1\nAWS_PAGER=\n' "$creds") \
  "$image" "$@"
