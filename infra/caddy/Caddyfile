# Story 11.8: the production edge. One secure-context origin, https://<Elastic IP>,
# serving the web bundle and /api/* from the api on the same host (host network mode).
# The certificate is a Let's Encrypt IP address certificate: the `shortlived` ACME
# profile (about six days, renewed by Caddy on its own) is the only profile Let's Encrypt
# issues IP certificates under, validated by HTTP-01 on port 80. Browsers trust it with
# no manual install on the tablets (docs/tablet-https-setup.md, production).
# /data (ACME account, certificates) is a host volume that survives restarts.
{
	email {$ACME_EMAIL}
	# A client that reaches an IP address sends no SNI; without a default the TLS
	# handshake finds no certificate and fails with an internal-error alert.
	default_sni {$PUBLIC_IP}
}

{$PUBLIC_IP} {
	tls {
		issuer acme {
			profile shortlived
		}
	}

	# Security review 2026-09-30: HSTS is the edge's (the api sends every other security
	# header itself, apps/api/src/http/security-headers.ts); no preload, no subdomains, as
	# the origin is a bare IP address. `-Server` drops the Caddy banner.
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy 127.0.0.1:3000
}

# The domain (Terraform `app_domain`): a regular Let's Encrypt certificate (about 90 days,
# renewed by Caddy), validated by HTTP-01 on port 80 once the domain's A record points at
# the Elastic IP. Unset, the name is `localhost`, which Caddy serves from its own internal
# CA and never asks Let's Encrypt for.
{$APP_DOMAIN:localhost} {
	reverse_proxy 127.0.0.1:3000
}

# The CloudFront fallback (infra/production/cloudfront.tf): CloudFront terminates TLS on
# its own *.cloudfront.net name and reaches this site over plain HTTP with that Host.
# Unset, the name matches nothing.
# Security review 2026-09-30 (I-8): only a request carrying CloudFront's origin secret
# (X-Origin-Verify, infra/production/cloudfront.tf) is proxied; port 80 is open to the world
# for ACME, and anything else sent with this Host over plain HTTP gets 403.
http://{$FALLBACK_HOST:fallback.invalid} {
	@cloudfront header X-Origin-Verify {$FALLBACK_ORIGIN_SECRET:fallback-disabled}
	handle @cloudfront {
		# CloudFront redirects viewers to HTTPS; the browser sees this header on its HTTPS name.
		header {
			Strict-Transport-Security "max-age=31536000"
			-Server
		}
		reverse_proxy 127.0.0.1:3000 {
			header_up -X-Origin-Verify
		}
	}
	respond 403
}
