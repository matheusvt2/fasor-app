{
  "name": "@app/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:fast": "vitest run -t '^(?!.*@slow)'"
  },
  "dependencies": {
    "@app/domain": "workspace:*",
    "@aws-sdk/client-s3": "3.1134.0",
    "@hono/node-server": "^2.1.1",
    "better-auth": "~1.7.5",
    "docx": "9.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "~4.13.8",
    "pdfjs-dist": "6.3.289",
    "pg-boss": "^12.0.0",
    "postgres": "^3.4.9",
    "sharp": "^0.34.5",
    "tsx": "^4.23.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
