# docker-compose already carries these defaults; copy to .env only to override them.
DATABASE_URL=postgres://app:app@postgres:5432/app
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=app-files
PORT=3000
SESSION_SECRET=change-me-change-me-change-me-32ch
# better-auth's own origin. Pinned (never derived from the request Host); defaults to the first trusted origin.
AUTH_BASE_URL=http://localhost:5173
# Origins allowed to call /api/auth/* (better-auth CSRF allowlist): the dev servers on any
# localhost port, the api itself and the Caddy HTTPS origin. Wildcards like http://localhost:* work.
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:*,http://127.0.0.1:*,http://api:3000,http://web:5173,https://localhost
# Security review 2026-09-30: the sign-in and push request limits; empty = on in production, off elsewhere.
RATE_LIMIT=
LLM_PROVIDER=fake
OCR_PROVIDER=fake
# Story 11.6: LLM_PROVIDER=bedrock structures readings and writes prose through Bedrock Converse,
# with the AWS SDK default credentials (the fasor-app session, never a stored key). Empty values
# take config.ts defaults: us-east-1, Claude Haiku 4.5 (global.anthropic.claude-haiku-4-5-20251001-v1:0),
# prose on the same model. BEDROCK_ESCALATION_MODEL_ID unset is Amazon Nova Pro; set it empty to
# turn the plate escalation off.
BEDROCK_REGION=
BEDROCK_MODEL_ID=
# Panel fronts: empty is Qwen3 VL 235B (qwen.qwen3-vl-235b-a22b); name BEDROCK_MODEL_ID's value to read them on the plate model.
BEDROCK_PANEL_MODEL_ID=
BEDROCK_PROSE_MODEL_ID=
# The plate escalation model: Amazon Nova Pro when this line stays commented out; uncommented and empty turns the escalation off.
# BEDROCK_ESCALATION_MODEL_ID=us.amazon.nova-pro-v1:0
# Story 9.4: the web app's Dictation engine, read at build time: `webspeech` (the browser's Web
# Speech API in pt-BR; on Chrome the audio goes to the browser vendor's service), `fake` (the
# test engine the `build:e2e` bundle uses) or `none` (no Dictation button anywhere).
# E9-A9: the default is `none`; `webspeech` is opt-in until Matheus approves vendor audio (Q18).
VITE_SPEECH_ENGINE=none

# Hostname or IP the tablet will type into its browser, e.g. 192.168.1.42.
# Used only by the mkcert and caddy services (Story 1.7); never auto-detected.
TABLET_HOST=localhost

# Host ports for caddy and the `prod` profile's api-prod. Override per checkout
# so multiple worktrees/stacks on one machine don't fight over 80/443/3001.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
API_PROD_PORT=3001
